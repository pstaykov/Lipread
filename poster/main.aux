\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Dasselbe Wort aus verschiedenen Sitzungen: Sprecher, Licht und Bildqualität variieren stark.}}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mit Transfer vom 500-Wort-Modell übertrifft GNet nach 5 Epochen das Training von Grund auf nach 80.}}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Grau: veröffentlichte Ergebnisse, blau: unsere (Test-Split). $^*$\,Wortauswahl nicht veröffentlicht, nur näherungsweise vergleichbar. $^\dagger $\,Ganzes Gesicht ohne Mund-Zuschnitt, daher nur zur Einordnung. $^\ddagger $\,Mit Vortraining auf allen 500 Wörtern.}}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Ohne Mund-Zuschnitt halbiert sich die Genauigkeit.}}{1}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Angaben in \%, Bestwert je Aufgabe blau. $\mitDelta $: Top-1 GNet minus MS-TCN.}}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Einfache Fusion bringt kaum mehr als reines Audio. Erst Attention zwischen Video- und Audio-Token hebt die Genauigkeit um 12 Punkte.}}{1}{}\protected@file@percent }
\newlabel{noiselegend}{{\expandafter\protect\csname pgfplots@legend@to@name@noiselegend\endcsname}{1}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Additives Rauschen im Audiosignal. Bei 5\,dB Babble fällt reines Audio unter das Nur-Video-Niveau, die Fusion bleibt mit 57,5\,\% deutlich darüber.}}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Aufnahmen in Train und Test (GLips-15), Fläche $\propto $ Anzahl; $\pm $: 95-\%-KI.}}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Konfusionsmatrix in \%. \textit  {herrn} wird nur zu 30\,\% erkannt: Homophene sehen auf den Lippen gleich aus.}}{1}{}\protected@file@percent }
